<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>BuildLedger ATO</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#0d0f18;--bg2:#161821;--bd:#1e2130;--gr:#2e9b6e;--gr2:#1a4a30;--rd:#c04444;--or:#c08030;--tx:#d0d0d0;--mu:#4a5a6a;--fn:'DM Mono',monospace;--hd:'Syne',sans-serif}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{background:var(--bg);color:var(--tx);font-family:var(--fn);min-height:100vh;font-size:14px}
.nav{background:#11131c;border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;padding:0 14px;position:sticky;top:0;z-index:100}
.nav-logo{display:flex;align-items:center;gap:8px;padding:13px 0}
.nav-dot{width:7px;height:7px;background:var(--gr);border-radius:50%}
.nav-title{font-family:var(--hd);font-size:13px;font-weight:900;color:#fff;letter-spacing:.06em}
.nav-tabs{display:flex;overflow-x:auto;-webkit-overflow-scrolling:touch}
.nav-tabs::-webkit-scrollbar{display:none}
.nav-tab{padding:10px 13px;cursor:pointer;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--mu);border-bottom:2px solid transparent;white-space:nowrap;transition:color .2s}
.nav-tab.active{color:var(--gr);border-bottom-color:var(--gr)}
.page{display:none;padding:18px 14px;max-width:900px;margin:0 auto}
.page.active{display:block}
.card{background:var(--bg2);border:1px solid var(--bd);border-radius:4px}
.cp{padding:14px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
@media(max-width:500px){.g4{grid-template-columns:1fr 1fr}.g3{grid-template-columns:1fr 1fr}}
.stat{background:var(--bg2);border:1px solid var(--bd);border-radius:4px;padding:13px 12px}
.sl{font-size:9px;color:var(--mu);text-transform:uppercase;letter-spacing:.12em;margin-bottom:7px}
.sv{font-family:var(--hd);font-size:18px;font-weight:800}
.btn{cursor:pointer;border:none;font-family:var(--fn);font-size:11px;letter-spacing:.1em;text-transform:uppercase;transition:all .18s;border-radius:2px}
.bp{background:var(--gr);color:#0d0f18;padding:11px 18px;font-weight:500}
.bp:active{background:#3ab87e}
.bg{background:transparent;color:var(--mu);border:1px solid #232636;padding:9px 14px}
.bg:active{border-color:var(--gr);color:var(--gr)}
.bd2{background:transparent;color:var(--rd);border:1px solid #2a1a1a;padding:5px 9px;font-size:10px}
.bd2:active{background:#2a1a1a}
.bfw{width:100%;padding:13px}
.lbl{font-size:10px;color:var(--mu);text-transform:uppercase;letter-spacing:.12em;display:block;margin-bottom:5px}
.inp{background:#0d0f18;border:1px solid var(--bd);color:var(--tx);padding:10px 12px;font-family:var(--fn);font-size:13px;width:100%;outline:none;border-radius:2px}
.inp:focus{border-color:var(--gr)}
select.inp{appearance:none;-webkit-appearance:none;cursor:pointer}
.fr{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(max-width:420px){.fr{grid-template-columns:1fr}}
.tog{display:flex;border:1px solid var(--bd);border-radius:3px;overflow:hidden;margin-bottom:4px}
.to{flex:1;padding:11px 6px;text-align:center;cursor:pointer;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--mu);transition:all .15s;user-select:none;line-height:1.4}
.to:active{opacity:.7}
.t-gr{background:#1a4a30 !important;color:var(--gr) !important;font-weight:500}
.t-sel{background:var(--gr) !important;color:#0d0f18 !important;font-weight:500}
.file-inp{display:block;width:100%;padding:14px 12px;background:#0d0f18;border:2px dashed var(--gr);border-radius:3px;color:var(--tx);font-family:var(--fn);font-size:13px;cursor:pointer;outline:none}
.file-inp:active{background:#0a1a10}
.img-prev{border:1px solid var(--bd);border-radius:3px;padding:8px;background:#0d0f18;margin-bottom:10px;text-align:center;display:none}
.img-prev img{max-width:100%;max-height:180px;object-fit:contain;border-radius:2px}
.scan-bar{display:none;background:rgba(46,155,110,.1);border:1px solid rgba(46,155,110,.2);color:var(--gr);padding:11px;border-radius:3px;text-align:center;font-size:12px;margin-bottom:8px}
.scan-bar.on{display:block;animation:pulse 1.2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.ok-bar{display:none;background:rgba(46,155,110,.1);border:1px solid rgba(46,155,110,.2);color:var(--gr);padding:9px 12px;border-radius:2px;font-size:11px;margin-top:8px}
.er-bar{display:none;background:rgba(192,68,68,.1);border:1px solid rgba(192,68,68,.2);color:var(--rd);padding:9px 12px;border-radius:2px;font-size:11px;margin-top:8px}
.tag{display:inline-block;padding:2px 7px;font-size:10px;border-radius:2px}
.ti{color:var(--gr);background:rgba(46,155,110,.12)}
.te{color:var(--rd);background:rgba(192,68,68,.12)}
.to2{color:var(--or);background:rgba(192,128,48,.12)}
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;font-size:12px}
th{color:var(--mu);font-weight:400;font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:8px 9px;border-bottom:1px solid var(--bd);text-align:left;white-space:nowrap}
td{padding:8px 9px;border-bottom:1px solid var(--bd)}
.pi{display:flex;align-items:center;padding:12px 14px;cursor:pointer;border-bottom:1px solid var(--bd);transition:background .15s}
.pi:last-child{border-bottom:none}
.pi:active{background:rgba(46,155,110,.04)}
.mb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:200;align-items:center;justify-content:center;padding:18px}
.mb.on{display:flex}
.mo{background:var(--bg2);border:1px solid var(--bd);border-radius:4px;padding:22px;width:100%;max-width:400px}
.lb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.95);z-index:300;align-items:center;justify-content:center}
.lb.on{display:flex}
.lb img{max-width:95vw;max-height:90vh;object-fit:contain;border-radius:3px}
.aton{background:rgba(192,128,48,.07);border:1px solid rgba(192,128,48,.2);border-radius:3px;padding:10px 13px;font-size:11px;color:#907030;line-height:1.6;margin-bottom:14px}
.qb{padding:5px 11px;border-radius:2px;font-size:10px;cursor:pointer;border:1px solid var(--bd);color:var(--mu);letter-spacing:.08em;text-transform:uppercase;transition:all .15s;display:inline-block;margin:0 4px 4px 0}
.qb.qa{background:var(--gr);color:#0d0f18;border-color:var(--gr)}
.es{padding:32px;text-align:center;color:var(--mu)}
.ei{font-size:30px;margin-bottom:10px}
.bt{font-family:var(--hd);font-size:22px;font-weight:900;color:#fff;letter-spacing:-.01em}
.su{font-size:12px;color:var(--mu);margin-top:3px}
.fb{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap}
.fr2{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.m8{margin-top:8px}.m12{margin-top:12px}.m16{margin-top:16px}.m20{margin-top:20px}
.mb8{margin-bottom:8px}.mb12{margin-bottom:12px}.mb16{margin-bottom:16px}.mb20{margin-bottom:20px}
.st{font-family:var(--hd);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:11px}
</style>
</head>
<body>

<div class="nav">
  <div class="nav-logo"><div class="nav-dot"></div><span class="nav-title">BUILDLEDGER</span></div>
  <div class="nav-tabs">
    <div class="nav-tab active" id="tab-dashboard" onclick="go('dashboard')">Dashboard</div>
    <div class="nav-tab" id="tab-overheads" onclick="go('overheads')">Overheads</div>
    <div class="nav-tab" id="tab-project" onclick="go('project')" style="display:none"></div>
    <div class="nav-tab" id="tab-report" onclick="go('report')">Report</div>
  </div>
</div>

<!-- DASHBOARD -->
<div class="page active" id="page-dashboard">
  <div class="fb mb20">
    <div><div class="bt">Overview</div><div class="su" id="d-sub">0 projects</div></div>
    <button class="btn bp" onclick="openModal()">+ New Project</button>
  </div>
  <div class="g4 mb16" id="d-stats"></div>
  <div class="card" id="d-projs"></div>
</div>

<!-- PROJECT -->
<div class="page" id="page-project">
  <div class="fb mb16">
    <div>
      <div style="font-size:10px;color:var(--mu);text-transform:uppercase;letter-spacing:.1em;margin-bottom:4px">Project</div>
      <div class="bt" id="p-title"></div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn bg" onclick="openRep()">P&amp;L Report</button>
      <button class="btn bp" onclick="openEntry('project')">+ Add Entry</button>
    </div>
  </div>
  <div class="g4 mb14" id="p-stats"></div>
  <div class="fr2" id="p-filter"></div>
  <div id="p-table"></div>
</div>

<!-- OVERHEADS -->
<div class="page" id="page-overheads">
  <div class="fb mb16">
    <div><div class="bt">Overhead Costs</div><div class="su">General business expenses</div></div>
    <button class="btn bp" onclick="openEntry('overhead')">+ Add Overhead</button>
  </div>
  <div class="g3 mb14" id="o-stats"></div>
  <div id="o-cats" class="mb12"></div>
  <div class="fr2" id="o-filter"></div>
  <div id="o-table"></div>
</div>

<!-- ENTRY FORM -->
<div class="page" id="page-entry">
  <div class="mb16">
    <button class="btn bg mb12" id="e-back">Back</button>
    <div class="bt" id="e-title">Add Entry</div>
  </div>

  <div class="card cp mb12">
    <div class="lbl mb8">Invoice / Receipt Photo</div>
    <div class="img-prev" id="e-imgwrap"><img id="e-img" src="" alt="Invoice"><div style="font-size:10px;color:var(--mu);margin-top:6px">Tap image to change</div></div>
    <div class="scan-bar" id="e-scan">Scanning with AI...</div>
    <input type="file" accept="image/*" class="file-inp" id="e-file" onchange="handleFile(this)">
    <div style="font-size:10px;color:#3a5a3a;margin-top:6px">Tap above: choose Take Photo or Photo Library</div>
    <div class="ok-bar" id="e-ok">AI extracted data - review and confirm</div>
    <div class="er-bar" id="e-er">Could not read image - fill in manually</div>
  </div>

  <div class="card cp mb12" id="e-scope-card">
    <div class="lbl">Entry Scope</div>
    <div class="tog">
      <div class="to t-sel" id="sc-proj" onclick="setScope('project')">Project Cost</div>
      <div class="to" id="sc-oh" onclick="setScope('overhead')">Overhead</div>
    </div>
  </div>

  <div class="card cp mb12" id="e-type-card">
    <div class="lbl">Transaction Type</div>
    <div class="tog">
      <div class="to" id="ty-inc" onclick="setType('income')">Money Received (Income)</div>
      <div class="to t-sel" id="ty-exp" onclick="setType('expense')">Money Paid (Expense)</div>
    </div>
    <div style="font-size:10px;color:#3a5a3a;margin-top:4px" id="ty-hint">You PAID this money to a supplier</div>
  </div>

  <div class="card cp mb12">
    <div class="fr mb12">
      <div><label class="lbl">Date</label><input type="date" class="inp" id="f-date"></div>
      <div><label class="lbl">Category</label><select class="inp" id="f-cat"></select></div>
    </div>
    <div class="mb12">
      <label class="lbl" id="f-sup-lbl">Supplier / Vendor Name</label>
      <input type="text" class="inp" id="f-sup" placeholder="Company or person name">
    </div>
    <div class="fr">
      <div><label class="lbl">Invoice No.</label><input type="text" class="inp" id="f-inv" placeholder="INV-001"></div>
      <div><label class="lbl">Description</label><input type="text" class="inp" id="f-desc" placeholder="What was bought/sold"></div>
    </div>
  </div>

  <div class="card cp mb16">
    <div class="lbl mb8">Amounts - enter any one, rest auto-calculate</div>
    <div class="g3">
      <div><label class="lbl">Ex-GST ($)</label><input type="number" step="0.01" min="0" class="inp" id="f-ex" placeholder="0.00" oninput="calcEx()"></div>
      <div><label class="lbl">GST 10% ($)</label><input type="number" step="0.01" min="0" class="inp" id="f-gst" placeholder="0.00"></div>
      <div><label class="lbl">Total incl. GST ($)</label><input type="number" step="0.01" min="0" class="inp" id="f-tot" placeholder="0.00" oninput="calcTot()"></div>
    </div>
    <div style="font-size:10px;color:#3a4a5a;margin-top:7px">No GST: enter 0 in GST field and fill amounts manually.</div>
  </div>

  <button class="btn bp bfw" onclick="saveEntry()">Save Entry</button>
  <div style="height:40px"></div>
</div>

<!-- REPORT -->
<div class="page" id="page-report">
  <div class="fb mb12">
    <div><div class="bt">Profit &amp; Loss</div><div class="su" id="r-sub">FY 2024-25</div></div>
    <select class="inp" style="width:auto;max-width:160px" id="r-psel" onchange="chRP()"></select>
  </div>
  <div class="aton">ATO Notice: Prepared per Australian Tax Office requirements. All amounts AUD. GST per A New Tax System (Goods and Services Tax) Act 1999. Retain documents 5 years.</div>
  <div id="r-qf" class="mb14"></div>
  <div class="card cp mb12">
    <div class="st" style="color:var(--or)">Quarterly Performance</div>
    <div class="tw"><table><thead><tr><th>Quarter</th><th>Revenue</th><th>Direct Costs</th><th>Gross</th><th>Overheads</th><th>Net</th><th>Margin</th></tr></thead><tbody id="r-qt"></tbody></table></div>
  </div>
  <div class="g2 mb12">
    <div class="card cp">
      <div class="st" style="color:var(--gr)">Revenue</div>
      <div class="tw"><table><thead><tr><th>Client</th><th>Cat.</th><th>Ex-GST</th></tr></thead><tbody id="r-inc"></tbody></table></div>
      <div class="m12" style="display:flex;justify-content:space-between;border-top:1px solid var(--gr);padding-top:9px">
        <span>Total Revenue</span><span id="r-tinc" style="color:var(--gr);font-family:var(--hd);font-weight:700"></span>
      </div>
    </div>
    <div class="card cp">
      <div class="st" style="color:var(--rd)">Direct Costs</div>
      <div class="tw"><table><thead><tr><th>Category</th><th>Amount</th></tr></thead><tbody id="r-cost"></tbody></table></div>
      <div class="m12" style="display:flex;justify-content:space-between;border-top:1px solid var(--rd);padding-top:9px">
        <span>Total Costs</span><span id="r-tcost" style="color:var(--rd);font-family:var(--hd);font-weight:700"></span>
      </div>
    </div>
  </div>
  <div class="card cp mb12" id="r-ohsec">
    <div class="st" style="color:var(--or)">Overhead Expenses</div>
    <div class="tw"><table><thead><tr><th>Category</th><th>Amount</th></tr></thead><tbody id="r-oh"></tbody></table></div>
  </div>
  <div class="card cp mb12"><div class="g4" id="r-net" style="gap:14px"></div></div>
  <div class="card cp mb12">
    <div class="st" style="color:var(--or)">GST / BAS Summary</div>
    <table style="max-width:440px"><tbody id="r-bas"></tbody></table>
    <div style="font-size:10px;color:#3a4a5a;margin-top:9px">Consult your registered tax agent before lodging BAS with ATO.</div>
  </div>
</div>

<!-- MODAL -->
<div class="mb" id="modal"><div class="mo">
  <div style="font-family:var(--hd);font-size:17px;font-weight:800;color:#fff;margin-bottom:15px">New Project</div>
  <input type="text" class="inp mb12" id="np-name" placeholder="e.g. Residential Build - Smith St">
  <div style="display:flex;gap:10px;margin-top:4px">
    <button class="btn bp" style="flex:1" onclick="addProj()">Create</button>
    <button class="btn bg" onclick="closeModal()">Cancel</button>
  </div>
</div></div>

<!-- LIGHTBOX -->
<div class="lb" id="lb" onclick="this.classList.remove('on')">
  <div style="text-align:center">
    <img id="lb-img" src="" alt="Invoice">
    <div style="font-size:11px;color:var(--mu);margin-top:10px">Tap to close</div>
  </div>
</div>

<script>
// ======= NO TEMPLATE LITERALS - pure string concat for mobile WebKit ========

var S = {
  projects: [],
  overheads: [],
  active: null,
  scope: 'project',
  type: 'expense',
  imgData: '',
  repProjId: null,
  repQ: 'all',
  fType: 'all',
  repFQ: 'all'
};

var OH = ['Rent / Lease','Electricity & Gas','Water','Internet & Phone','Accounting & Legal','Bank Charges','Software Subscriptions','Office Supplies','Vehicle Running Costs','Insurance (General)','Staff Wages (Admin)','Cleaning','Other Overhead'];
var EX = ['Cost of Goods Sold','Subcontractors','Labour (Direct)','Materials & Supplies','Equipment Hire','Site Costs','Travel & Accommodation','Permits & Inspections','Other Project Cost'];
var IC = ['Contract Revenue','Progress Claim','Final Payment','Variation / Extra','Retention Released','Service Fee','Other Income'];
var AC = IC.concat(EX).concat(OH);
var QS = [{l:'Q1 Jul-Sep',m:[7,8,9]},{l:'Q2 Oct-Dec',m:[10,11,12]},{l:'Q3 Jan-Mar',m:[1,2,3]},{l:'Q4 Apr-Jun',m:[4,5,6]}];

function fAUD(n) {
  return new Intl.NumberFormat('en-AU',{style:'currency',currency:'AUD',minimumFractionDigits:2}).format(n||0);
}
function fDate(iso) {
  if(!iso) return '-';
  return new Date(iso+'T00:00:00').toLocaleDateString('en-AU');
}
function txM(tx) { return parseInt((tx.date||'').split('-')[1]||0); }
function gProj(id) { for(var i=0;i<S.projects.length;i++){if(S.projects[i].id===id)return S.projects[i];} return null; }
function today() { return new Date().toISOString().split('T')[0]; }
function el(id) { return document.getElementById(id); }
function h(id,html) { el(id).innerHTML = html; }

function calcPL(txs) {
  var ti=0,te=0,gc=0,gcr=0,bc={};
  for(var i=0;i<txs.length;i++){
    var t=txs[i];
    if(t.type==='income'){ti+=t.ex;gc+=t.gst;}
    else{te+=t.ex;gcr+=t.gst;bc[t.cat]=(bc[t.cat]||0)+t.ex;}
  }
  return {ti:ti,te:te,gr:ti-te,gc:gc,gcr:gcr,ng:gc-gcr,bc:bc};
}

function fQ(txs,q) {
  if(q==='all') return txs;
  var qo=null;
  for(var i=0;i<QS.length;i++){if(QS[i].l===q){qo=QS[i];break;}}
  if(!qo) return txs;
  var out=[];
  for(var i=0;i<txs.length;i++){if(qo.m.indexOf(txM(txs[i]))>=0)out.push(txs[i]);}
  return out;
}

function fT(txs,f) {
  if(f==='all') return txs;
  var out=[];
  for(var i=0;i<txs.length;i++){if(txs[i].type===f)out.push(txs[i]);}
  return out;
}

// ===== NAVIGATION =====
function go(name) {
  var pages=['dashboard','project','overheads','entry','report'];
  for(var i=0;i<pages.length;i++){
    var p=el('page-'+pages[i]);
    if(p) p.className = p.className.replace(' active','').replace('active','').trim() + (pages[i]===name?' active':'');
  }
  var tabs=['dashboard','overheads','report'];
  for(var i=0;i<tabs.length;i++){
    var t=el('tab-'+tabs[i]);
    if(t) t.className = t.className.replace(' active','').replace('active','').trim() + (tabs[i]===name?' active':'');
  }
  var pt=el('tab-project');
  if(pt) pt.className = pt.className.replace(' active','').replace('active','').trim() + (name==='project'?' active':'');
  if(name==='dashboard') rDash();
  if(name==='project') rProj();
  if(name==='overheads') rOH();
  if(name==='report') rReport();
}

// ===== MODAL =====
function openModal() { el('modal').className='mb on'; setTimeout(function(){el('np-name').focus();},100); }
function closeModal() { el('modal').className='mb'; el('np-name').value=''; }
el('np-name').addEventListener('keydown',function(e){if(e.key==='Enter')addProj();});

function addProj() {
  var name=el('np-name').value.trim();
  if(!name) return;
  var p={id:Date.now(),name:name,txs:[],created:today()};
  S.projects.push(p);
  S.active=p.id;
  closeModal();
  var pt=el('tab-project');
  pt.textContent=name; pt.style.display='';
  go('project');
}

// ===== DASHBOARD =====
function rDash() {
  var allTx=[];
  for(var i=0;i<S.projects.length;i++) allTx=allTx.concat(S.projects[i].txs);
  var dp=calcPL(allTx), op=calcPL(S.overheads);
  var rev=dp.ti, exp=dp.te+op.te, net=rev-exp;
  el('d-sub').textContent = S.projects.length+' projects - FY 2024-25';
  var sc=[
    {l:'Total Revenue',v:fAUD(rev),c:'var(--gr)'},
    {l:'Direct Costs',v:fAUD(dp.te),c:'var(--rd)'},
    {l:'Overheads',v:fAUD(op.te),c:'var(--or)'},
    {l:'Net Profit',v:fAUD(net),c:net>=0?'var(--gr)':'var(--rd)'}
  ];
  var sh='';
  for(var i=0;i<sc.length;i++){
    sh+='<div class="stat"><div class="sl">'+sc[i].l+'</div><div class="sv" style="color:'+sc[i].c+'">'+sc[i].v+'</div></div>';
  }
  h('d-stats',sh);
  if(S.projects.length===0){
    h('d-projs','<div class="es"><div class="ei">&#128193;</div><div>No projects yet.</div><br><button class="btn bp" onclick="openModal()">Create First Project</button></div>');
    return;
  }
  var ph='';
  for(var i=0;i<S.projects.length;i++){
    var p=S.projects[i], pl=calcPL(p.txs);
    ph+='<div class="pi" onclick="openP('+p.id+')">'
      +'<div style="flex:1"><div style="font-family:var(--hd);font-weight:700;font-size:14px;color:#e8e8e8">'+p.name+'</div>'
      +'<div style="font-size:11px;color:var(--mu);margin-top:2px">'+p.txs.length+' transactions</div></div>'
      +'<div style="display:flex;gap:14px;text-align:right;align-items:center;flex-wrap:wrap">'
      +'<div><div style="font-size:9px;color:var(--mu);text-transform:uppercase;letter-spacing:.08em">Revenue</div><div style="color:var(--gr);font-size:13px;font-weight:500">'+fAUD(pl.ti)+'</div></div>'
      +'<div><div style="font-size:9px;color:var(--mu);text-transform:uppercase;letter-spacing:.08em">Net</div><div style="color:'+(pl.gr>=0?'var(--gr)':'var(--rd)')+';font-size:13px;font-weight:500">'+fAUD(pl.gr)+'</div></div>'
      +'<button class="btn bg" style="padding:5px 10px;font-size:10px" onclick="event.stopPropagation();S.repProjId='+p.id+';go(\'report\')">Report</button>'
      +'</div></div>';
  }
  h('d-projs',ph);
}

function openP(id) { S.active=id; var p=gProj(id); if(p){var pt=el('tab-project');pt.textContent=p.name;pt.style.display='';} go('project'); }

// ===== PROJECT =====
function rProj() {
  var p=gProj(S.active); if(!p) return;
  el('p-title').textContent=p.name;
  var pl=calcPL(p.txs);
  var sc=[
    {l:'Revenue (ex-GST)',v:fAUD(pl.ti),c:'var(--gr)'},
    {l:'Direct Costs',v:fAUD(pl.te),c:'var(--rd)'},
    {l:'Gross Profit',v:fAUD(pl.gr),c:pl.gr>=0?'var(--gr)':'var(--rd)'},
    {l:'Net GST',v:fAUD(pl.ng),c:'var(--or)'}
  ];
  var sh='';
  for(var i=0;i<sc.length;i++) sh+='<div class="stat"><div class="sl">'+sc[i].l+'</div><div class="sv" style="color:'+sc[i].c+'">'+sc[i].v+'</div></div>';
  h('p-stats',sh);
  rFilter('p-filter',false);
  rTbl('p-table',p.txs,false);
}

// ===== OVERHEADS =====
function rOH() {
  var pl=calcPL(S.overheads);
  var sc=[
    {l:'Total Overheads',v:fAUD(pl.te),c:'var(--or)'},
    {l:'GST Credits',v:fAUD(pl.gcr),c:'var(--gr)'},
    {l:'Entries',v:S.overheads.length,c:'#8090a0'}
  ];
  var sh='';
  for(var i=0;i<sc.length;i++) sh+='<div class="stat"><div class="sl">'+sc[i].l+'</div><div class="sv" style="color:'+sc[i].c+'">'+sc[i].v+'</div></div>';
  h('o-stats',sh);
  var bc={};
  for(var i=0;i<S.overheads.length;i++){if(S.overheads[i].type==='expense') bc[S.overheads[i].cat]=(bc[S.overheads[i].cat]||0)+S.overheads[i].ex;}
  var keys=Object.keys(bc);
  if(keys.length>0){
    keys.sort(function(a,b){return bc[b]-bc[a];});
    var ch='<div class="card cp"><div style="font-size:9px;color:var(--mu);text-transform:uppercase;letter-spacing:.1em;margin-bottom:9px">By Category</div><div style="display:flex;flex-wrap:wrap;gap:7px">';
    for(var i=0;i<keys.length;i++) ch+='<div style="background:#0d0f18;border:1px solid var(--bd);padding:5px 10px;border-radius:2px;font-size:12px"><span style="color:#6a7a8a">'+keys[i]+'</span><span style="color:var(--or);margin-left:8px">'+fAUD(bc[keys[i]])+'</span></div>';
    ch+='</div></div>';
    h('o-cats',ch);
  } else h('o-cats','');
  rFilter('o-filter',true);
  rTbl('o-table',S.overheads,true);
}

// ===== FILTER ROW =====
function rFilter(cid, isOH) {
  var fs=['all','income','expense'], lbs=['All','Income','Expense'];
  var fh='';
  for(var i=0;i<fs.length;i++){
    var act=S.fType===fs[i];
    var cb=isOH?'rOH()':'rProj()';
    fh+='<button class="btn '+(act?'bp':'bg')+'" style="padding:6px 12px;font-size:10px" onclick="S.fType=\''+fs[i]+'\';'+cb+'">'+lbs[i]+'</button>';
  }
  h(cid,fh);
}

// ===== TX TABLE =====
function rTbl(cid, txs, isOH) {
  var filt=fT(txs,S.fType);
  filt.sort(function(a,b){return b.date>a.date?1:-1;});
  if(filt.length===0){h(cid,'<div class="es"><div class="ei">&#128203;</div><div>No entries yet.</div></div>');return;}
  var rows='';
  for(var i=0;i<filt.length;i++){
    var tx=filt[i];
    var tag=tx.type==='income'?'<span class="tag ti">Income</span>':isOH?'<span class="tag to2">Overhead</span>':'<span class="tag te">Expense</span>';
    var ac=tx.type==='income'?'var(--gr)':'var(--rd)';
    var doc=tx.imgData?'<button class="btn bg" style="padding:4px 8px;font-size:10px" onclick="showLB('+tx.id+','+isOH+')">View</button>':'<span style="color:#2a3040">-</span>';
    rows+='<tr>'
      +'<td style="color:var(--mu);white-space:nowrap">'+fDate(tx.date)+'</td>'
      +'<td>'+tag+'</td>'
      +'<td style="font-size:11px;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+(tx.sup||'-')+'</td>'
      +'<td style="font-size:11px;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+(tx.desc||'-')+'</td>'
      +'<td style="font-size:10px;color:var(--mu)">'+(tx.cat||'-')+'</td>'
      +'<td style="color:'+ac+';white-space:nowrap">'+fAUD(tx.ex)+'</td>'
      +'<td style="color:var(--or);font-size:11px;white-space:nowrap">'+fAUD(tx.gst)+'</td>'
      +'<td style="font-weight:500;white-space:nowrap">'+fAUD(tx.tot)+'</td>'
      +'<td>'+doc+'</td>'
      +'<td><button class="btn bd2" onclick="delTx('+tx.id+','+isOH+')">x</button></td>'
      +'</tr>';
  }
  h(cid,'<div class="card tw"><table><thead><tr><th>Date</th><th>Type</th><th>Supplier</th><th>Description</th><th>Category</th><th>Ex-GST</th><th>GST</th><th>Total</th><th>Doc</th><th></th></tr></thead><tbody>'+rows+'</tbody></table></div>');
}

function showLB(id, isOH) {
  var txs=isOH?S.overheads:(gProj(S.active)||{txs:[]}).txs;
  for(var i=0;i<txs.length;i++){if(txs[i].id===id&&txs[i].imgData){el('lb-img').src=txs[i].imgData;el('lb').className='lb on';return;}}
}

function delTx(id, isOH) {
  if(!confirm('Delete this entry?')) return;
  if(isOH){S.overheads=S.overheads.filter(function(t){return t.id!==id;});}
  else{var p=gProj(S.active);if(p)p.txs=p.txs.filter(function(t){return t.id!==id;});}
  isOH?rOH():rProj();
}

// ===== ENTRY FORM =====
function openEntry(scope) {
  S.scope=scope; S.type='expense'; S.imgData='';
  el('f-date').value=today();
  el('f-cat').value=''; el('f-sup').value=''; el('f-inv').value=''; el('f-desc').value='';
  el('f-ex').value=''; el('f-gst').value=''; el('f-tot').value='';
  el('e-imgwrap').style.display='none';
  el('e-scan').className='scan-bar';
  el('e-ok').style.display='none'; el('e-er').style.display='none';
  el('e-file').value='';
  el('e-scope-card').style.display=S.active?'':'none';
  setScope(scope); setType('expense');
  el('e-back').onclick=function(){go(scope==='overhead'?'overheads':'project');};
  var p=gProj(S.active);
  el('e-title').textContent=scope==='overhead'?'Add Overhead Expense':('Add Entry - '+(p?p.name:''));
  go('entry');
}

function setScope(s) {
  S.scope=s;
  el('sc-proj').className='to'+(s==='project'?' t-sel':'');
  el('sc-oh').className='to'+(s==='overhead'?' t-sel':'');
  el('e-type-card').style.display=s==='overhead'?'none':'';
  updCats();
}

function setType(t) {
  S.type=t;
  el('ty-inc').className='to'+(t==='income'?' t-gr':'');
  el('ty-exp').className='to'+(t==='expense'?' t-sel':'');
  el('ty-hint').textContent=t==='income'?'You RECEIVED this money from a client':'You PAID this money to a supplier';
  el('f-sup-lbl').textContent=t==='income'?'Client / Payer Name':'Supplier / Vendor Name';
  updCats();
}

function updCats() {
  var cats=S.scope==='overhead'?OH:(S.type==='income'?IC:EX);
  var o='';
  for(var i=0;i<cats.length;i++) o+='<option>'+cats[i]+'</option>';
  el('f-cat').innerHTML=o;
}

function calcTot() {
  var tot=parseFloat(el('f-tot').value);
  if(isNaN(tot)) return;
  var gst=Math.round(tot/11*100)/100;
  el('f-gst').value=gst.toFixed(2);
  el('f-ex').value=(tot-gst).toFixed(2);
}

function calcEx() {
  var ex=parseFloat(el('f-ex').value);
  if(isNaN(ex)) return;
  var gst=Math.round(ex*0.1*100)/100;
  el('f-gst').value=gst.toFixed(2);
  el('f-tot').value=(ex+gst).toFixed(2);
}

function saveEntry() {
  var tx={
    id:Date.now(),
    type:S.scope==='overhead'?'expense':S.type,
    date:el('f-date').value||today(),
    cat:el('f-cat').value,
    sup:el('f-sup').value,
    inv:el('f-inv').value,
    desc:el('f-desc').value,
    ex:parseFloat(el('f-ex').value)||0,
    gst:parseFloat(el('f-gst').value)||0,
    tot:parseFloat(el('f-tot').value)||0,
    imgData:S.imgData
  };
  if(S.scope==='overhead'){S.overheads.push(tx);go('overheads');}
  else{var p=gProj(S.active);if(p)p.txs.push(tx);go('project');}
}

// ===== FILE UPLOAD =====
function handleFile(input) {
  var file=input.files&&input.files[0];
  if(!file) return;
  var reader=new FileReader();
  reader.onload=function(e){
    var b64=e.target.result.split(',')[1];
    var durl='data:'+file.type+';base64,'+b64;
    S.imgData=durl;
    el('e-img').src=durl;
    el('e-imgwrap').style.display='';
    el('e-imgwrap').onclick=function(){input.click();};
    el('e-scan').className='scan-bar on';
    el('e-ok').style.display='none'; el('e-er').style.display='none';
    scanAI(b64, file.type);
  };
  reader.readAsDataURL(file);
}

function scanAI(b64, mime) {
  var prompt='Extract invoice/receipt. Return ONLY valid JSON no markdown: {"type":"expense","date":"YYYY-MM-DD","supplier":"","invoiceNumber":"","description":"","category":"","exGST":0,"gst":0,"total":0}. Rules: payment received=income else expense. If no GST shown: gst=total/11. Category must be one of: '+AC.join(',');
  fetch('https://api.anthropic.com/v1/messages',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      model:'claude-sonnet-4-20250514',max_tokens:800,
      messages:[{role:'user',content:[
        {type:'image',source:{type:'base64',media_type:mime,data:b64}},
        {type:'text',text:prompt}
      ]}]
    })
  }).then(function(r){return r.json();}).then(function(data){
    var text=(data.content||[]).map(function(c){return c.text||'';}).join('');
    var clean=text.replace(/```json/g,'').replace(/```/g,'').trim();
    var parsed=JSON.parse(clean);
    if(parsed.date) el('f-date').value=parsed.date;
    if(parsed.supplier) el('f-sup').value=parsed.supplier;
    if(parsed.invoiceNumber) el('f-inv').value=parsed.invoiceNumber;
    if(parsed.description) el('f-desc').value=parsed.description;
    if(parsed.exGST) el('f-ex').value=parsed.exGST.toFixed(2);
    if(parsed.gst) el('f-gst').value=parsed.gst.toFixed(2);
    if(parsed.total) el('f-tot').value=parsed.total.toFixed(2);
    var isOH=OH.indexOf(parsed.category)>=0;
    setScope(isOH?'overhead':'project');
    if(!isOH&&parsed.type) setType(parsed.type);
    if(parsed.category){
      var s=el('f-cat');
      for(var i=0;i<s.options.length;i++){if(s.options[i].value===parsed.category){s.selectedIndex=i;break;}}
    }
    el('e-scan').className='scan-bar';
    el('e-ok').style.display='';
  }).catch(function(){
    el('e-scan').className='scan-bar';
    el('e-er').style.display='';
  });
}

// ===== REPORT =====
function openRep() { S.repProjId=S.active; go('report'); }
function chRP() { var v=el('r-psel').value; S.repProjId=v?parseInt(v):null; rReport(); }

function rReport() {
  var tgts=S.repProjId?[gProj(S.repProjId)].filter(Boolean):S.projects;
  var d=new Date().toLocaleDateString('en-AU',{day:'2-digit',month:'long',year:'numeric'});
  el('r-sub').textContent='FY 2024-25 - '+d+' - ATO Compliant';

  // project selector
  var po='<option value="">All Projects</option>';
  for(var i=0;i<S.projects.length;i++) po+='<option value="'+S.projects[i].id+'"'+(S.repProjId===S.projects[i].id?' selected':'')+'>'+S.projects[i].name+'</option>';
  el('r-psel').innerHTML=po;

  // quarter buttons
  var qh='<div class="qb'+(S.repFQ==='all'?' qa':'')+'" onclick="S.repFQ=\'all\';rReport()">Full Year</div>';
  for(var i=0;i<QS.length;i++) qh+='<div class="qb'+(S.repFQ===QS[i].l?' qa':'')+'" onclick="S.repFQ=\''+QS[i].l+'\';rReport()">'+QS[i].l+'</div>';
  h('r-qf',qh);

  // quarterly table
  var qrows='';
  for(var i=0;i<QS.length;i++){
    var q=QS[i];
    var ptx=[];
    for(var j=0;j<tgts.length;j++) ptx=ptx.concat(fQ(tgts[j].txs,q.l));
    var otx=fQ(S.overheads,q.l);
    var pp=calcPL(ptx), op=calcPL(otx);
    var gross=pp.ti-pp.te, net=gross-op.te, margin=pp.ti>0?(net/pp.ti*100):0;
    var nc=net>=0?'var(--gr)':'var(--rd)';
    var gc2=gross>=0?'var(--gr)':'var(--rd)';
    var mc2=margin>=0?'#5a7a6a':'var(--rd)';
    qrows+='<tr style="cursor:pointer" onclick="S.repFQ=\''+q.l+'\';rReport()">'
      +'<td style="color:'+(S.repFQ===q.l?'var(--gr)':'var(--mu)')+'">'+q.l+'</td>'
      +'<td style="color:var(--gr)">'+fAUD(pp.ti)+'</td>'
      +'<td style="color:var(--rd)">'+fAUD(pp.te)+'</td>'
      +'<td style="color:'+gc2+'">'+fAUD(gross)+'</td>'
      +'<td style="color:var(--or)">'+fAUD(op.te)+'</td>'
      +'<td style="color:'+nc+';font-weight:500">'+fAUD(net)+'</td>'
      +'<td style="color:'+mc2+'">'+margin.toFixed(1)+'%</td>'
      +'</tr>';
  }
  h('r-qt',qrows);

  // detail for selected quarter
  var fq=S.repFQ;
  var ftx=[];
  for(var i=0;i<tgts.length;i++){var q2=fQ(tgts[i].txs,fq);for(var j=0;j<q2.length;j++){var t=Object.assign({},q2[j]);t.pname=tgts[i].name;ftx.push(t);}}
  var foh=fQ(S.overheads,fq);
  var pl=calcPL(ftx), opl=calcPL(foh);
  var netP=pl.ti-pl.te-opl.te, tgcr=pl.gcr+opl.gcr, netG=pl.gc-tgcr;

  // income rows
  var inc=ftx.filter(function(t){return t.type==='income';});
  var ir=inc.length===0?'<tr><td colspan="3" style="color:#2a3a4a;text-align:center">No income</td></tr>':'';
  for(var i=0;i<inc.length;i++){
    var t=inc[i];
    ir+='<tr><td style="font-size:11px">'+(t.sup||t.desc||'-')+'<br><span style="font-size:10px;color:var(--mu)">'+fDate(t.date)+(t.pname?' - '+t.pname:'')+'</span></td>'
      +'<td style="font-size:10px;color:var(--mu)">'+t.cat+'</td>'
      +'<td style="color:var(--gr)">'+fAUD(t.ex)+'</td></tr>';
  }
  h('r-inc',ir);
  el('r-tinc').textContent=fAUD(pl.ti);

  // cost rows
  var keys=Object.keys(pl.bc); keys.sort(function(a,b){return pl.bc[b]-pl.bc[a];});
  var cr=keys.length===0?'<tr><td colspan="2" style="color:#2a3a4a;text-align:center">No costs</td></tr>':'';
  for(var i=0;i<keys.length;i++) cr+='<tr><td style="font-size:11px">'+keys[i]+'</td><td style="color:var(--rd)">'+fAUD(pl.bc[keys[i]])+'</td></tr>';
  h('r-cost',cr);
  el('r-tcost').textContent=fAUD(pl.te);

  // overhead rows
  if(opl.te>0){
    el('r-ohsec').style.display='';
    var ok=Object.keys(opl.bc); ok.sort(function(a,b){return opl.bc[b]-opl.bc[a];});
    var or2='';
    for(var i=0;i<ok.length;i++) or2+='<tr><td style="font-size:11px">'+ok[i]+'</td><td style="color:var(--or)">'+fAUD(opl.bc[ok[i]])+'</td></tr>';
    or2+='<tr style="border-top:1px solid #704020"><td style="font-weight:500;padding-top:9px">Total Overheads</td><td style="color:var(--or);font-family:var(--hd);font-weight:700;padding-top:9px">'+fAUD(opl.te)+'</td></tr>';
    h('r-oh',or2);
  } else el('r-ohsec').style.display='none';

  // net summary
  var gross2=pl.ti-pl.te;
  var nr=[
    {l:'Revenue',v:fAUD(pl.ti),c:'var(--gr)'},
    {l:'Less: Direct Costs',v:'('+fAUD(pl.te)+')',c:'var(--rd)'},
    {l:'Gross Profit',v:fAUD(gross2),c:gross2>=0?'var(--gr)':'var(--rd)'},
    {l:'Less: Overheads',v:'('+fAUD(opl.te)+')',c:'var(--or)'},
    {l:'NET PROFIT / (LOSS)',v:fAUD(netP),c:netP>=0?'var(--gr)':'var(--rd)',big:true}
  ];
  var nh='';
  for(var i=0;i<nr.length;i++) nh+='<div><div style="font-size:9px;color:var(--mu);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">'+nr[i].l+'</div><div style="font-family:var(--hd);font-size:'+(nr[i].big?'20px':'15px')+';font-weight:'+(nr[i].big?900:700)+';color:'+nr[i].c+'">'+nr[i].v+'</div></div>';
  h('r-net',nh);

  // BAS
  var bh='<tr><td>G1 - Total Sales (incl. GST)</td><td style="text-align:right">'+fAUD(pl.ti+pl.gc)+'</td></tr>'
    +'<tr><td>1A - GST on Sales</td><td style="text-align:right;color:var(--or)">'+fAUD(pl.gc)+'</td></tr>'
    +'<tr><td>G11 - Total Purchases (incl. GST)</td><td style="text-align:right">'+fAUD(pl.te+opl.te+tgcr)+'</td></tr>'
    +'<tr><td>1B - GST Credits</td><td style="text-align:right;color:var(--gr)">'+fAUD(tgcr)+'</td></tr>'
    +'<tr style="border-top:2px solid #704020"><td style="font-weight:500;padding-top:9px">Net GST Payable (1A - 1B)</td><td style="text-align:right;color:var(--or);font-family:var(--hd);font-weight:700;padding-top:9px">'+fAUD(netG)+'</td></tr>';
  h('r-bas',bh);
}

